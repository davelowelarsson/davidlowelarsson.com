{
  "name": "davidlowelarsson.com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "media:sync": "node --experimental-strip-types scripts/media-sync.mjs",
    "media:check": "node --experimental-strip-types scripts/media-check.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run e2e"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.2.0",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "wrangler": {
      "undici": "^7.29.0"
    }
  }
