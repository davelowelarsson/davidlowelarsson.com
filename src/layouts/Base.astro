---
import { CLOUDFLARE_ANALYTICS_TOKEN } from 'astro:env/client';
import Lightbox from '../components/Lightbox.astro';
import Mermaid from '../components/Mermaid.astro';
import { isCurrentPage, MASTHEAD_NAV } from '../lib/nav';
import { SALTAST_URL } from '../lib/saltast';
import { AUTHOR } from '../lib/seo';
import { THEME_ATTRIBUTE, THEME_STORAGE_KEY, THEMES } from '../lib/theme';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  jsonLd?: Record<string, unknown>;
  /** Teaser pages: keep them out of search results without hiding the URL. */
  noindex?: boolean;
}

const {
  title,
  description = 'Notes from David Lowe Larsson — platform engineering, flow, home-lab experiments, and roots in 3D art.',
  ogType = 'website',
  ogImage,
  publishedTime,
  jsonLd,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ?? new URL('/og-default.png', Astro.site).href;

// Theme icons for narrow screens, where three words do not fit beside a
// centred site name. Inline SVG rather than an icon font or a unicode glyph:
// no extra request, `currentColor` so they follow the palette in both themes,
// and no dependence on which symbols a system font happens to carry.
// They are decorative — each button's accessible name comes from its label,
// which stays in the DOM and is only visually hidden.
const THEME_ICONS: Record<string, string> = {
  light:
    '<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="8" cy="8" r="3"/><path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3.05 3.05l1.06 1.06M11.89 11.89l1.06 1.06M12.95 3.05l-1.06 1.06M4.11 11.89l-1.06 1.06"/></svg>',
  dark: '<svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><path d="M13.5 10.4A6.2 6.2 0 0 1 5.6 2.5a6 6 0 1 0 7.9 7.9z"/></svg>',
  system:
    '<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="5.5"/><path d="M8 2.5a5.5 5.5 0 0 1 0 11z" fill="currentColor" stroke="none"/></svg>',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      THE NO-FLASH CONTRACT. This must stay an inline, parser-blocking classic
      script at the top of <head>, ahead of the stylesheet. It runs before the
      first paint, so a reader who chose dark never sees a white page flash.
      Bundling it, making it a module, or moving it below the stylesheet all
      break that silently — nothing errors, the flash just comes back. So the
      guarantee is asserted STRUCTURALLY in e2e/theme.spec.ts, the same way the
      byline rotation's is. `define:vars` implies is:inline; both are written
      out so the intent survives a refactor.
    */}
    <script
      is:inline
      define:vars={{ storageKey: THEME_STORAGE_KEY, attribute: THEME_ATTRIBUTE }}
    >
      try {
        var stored = localStorage.getItem(storageKey);
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.setAttribute(attribute, stored);
        }
      } catch (e) {
        /* storage blocked (private mode, embedded webview) — follow the OS */
      }
    </script>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="David Lowe Larsson" href="/rss.xml" />
    {/* Warm the connection to saltast.com so the footer tally fetch is quicker. */}
    <link rel="preconnect" href="https://saltast.com" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={AUTHOR.name} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {
      CLOUDFLARE_ANALYTICS_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: CLOUDFLARE_ANALYTICS_TOKEN })}
        />
      )
    }
  </head>
  <body>
    {/*
      First focusable thing on the page, so a keyboard reader can bypass the
      masthead on every Post instead of tabbing through it each time. Hidden
      until focused — off-canvas rather than display:none, because a hidden
      element cannot receive focus at all.
    */}
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="site-name" href="/">David Lowe Larsson</a>
      <nav class="site-nav" aria-label="Main">
        {
          MASTHEAD_NAV.map(({ href, label }) => (
            <a href={href} aria-current={isCurrentPage(href, Astro.url.pathname) ? 'page' : null}>
              {label}
            </a>
          ))
        }
      </nav>
      {/*
        A labelled group reporting which option is active — not a mystery icon,
        and not a toggle that hides the third state. Three buttons, one pressed.
      */}
      <div class="theme" role="group" aria-label="Colour theme">
        {
          THEMES.map((theme) => (
            <button type="button" data-theme-set={theme} aria-pressed="false">
              <span class="theme-icon" aria-hidden="true" set:html={THEME_ICONS[theme]} />
              <span class="theme-label">{theme === 'system' ? 'auto' : theme}</span>
            </button>
          ))
        }
      </div>
      {/*
        Adjacent inline script, the byline pattern: the buttons are in <body>,
        so this cannot be the pre-paint step (that one is in <head>) — its job
        is to make the control agree with the attribute already applied, before
        the reader can see a wrong `aria-pressed`, and to wire the clicks.
      */}
      <script
        is:inline
        define:vars={{ storageKey: THEME_STORAGE_KEY, attribute: THEME_ATTRIBUTE }}
      >
        (function () {
          var root = document.documentElement;
          var buttons = Array.prototype.slice.call(
            document.querySelectorAll('[data-theme-set]'),
          );

          function paint(value) {
            for (var i = 0; i < buttons.length; i++) {
              buttons[i].setAttribute(
                'aria-pressed',
                String(buttons[i].dataset.themeSet === value),
              );
            }
          }

          function apply(value) {
            if (value === 'light' || value === 'dark') root.setAttribute(attribute, value);
            else root.removeAttribute(attribute);
            try {
              localStorage.setItem(storageKey, value);
            } catch (e) {
              /* storage blocked — the choice still applies for this page */
            }
            paint(value);
          }

          paint(root.getAttribute(attribute) || 'system');

          for (var i = 0; i < buttons.length; i++) {
            buttons[i].addEventListener('click', function (event) {
              apply(event.currentTarget.dataset.themeSet);
            });
          }
        })();
      </script>
    </header>
    {/* tabindex="-1" so activating the skip link actually MOVES focus here,
        rather than only scrolling — a <main> is not focusable by default. */}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer>
      <a href={AUTHOR.linkedin}>LinkedIn</a>
      <a href={AUTHOR.github}>GitHub</a>
      <a href="/rss.xml">RSS</a>
      {/*
        saltast.com link renders immediately; the tally span sits AFTER it and
        is the last content on the page, so the script filling it grows only
        downward — the link never moves, nothing above shifts (no CLS). No JS →
        just the link. See the saltast script below + docs/astro-field-guide.md.
      */}
      <span class="saltast-footer"
        ><a href={SALTAST_URL}>saltast.com</a><span
          class="saltast-tally"
          data-saltast-tally
          aria-live="polite"></span></span>
    </footer>
    <Lightbox />
    <Mermaid />
    <script>
      import {
        type ExperimentSummary,
        SALTAST_SUMMARY_URL,
        experimentStats,
        parseSummary,
        totalLabel,
      } from '../lib/saltast';

      const elements = document.querySelectorAll('[data-saltast-tally]');
      if (elements.length > 0) {
        const CACHE_KEY = 'saltast:summary';

        const readCache = () => {
          try {
            const raw = sessionStorage.getItem(CACHE_KEY);
            return raw ? parseSummary(JSON.parse(raw)) : null;
          } catch {
            return null;
          }
        };

        const render = (el: Element, summary: ExperimentSummary) => {
          el.textContent = '';
          el.setAttribute('data-saltast-state', 'loaded');

          const total = document.createElement('span');
          total.className = 'saltast-total';
          total.textContent = totalLabel(summary);
          el.append(total);

          const stats = document.createElement('span');
          stats.className = 'saltast-stats';
          for (const { key, count } of experimentStats(summary)) {
            const stat = document.createElement('span');
            stat.className = `saltast-stat saltast-stat--${key}`;
            const dot = document.createElement('span');
            dot.className = 'saltast-dot';
            dot.setAttribute('aria-hidden', 'true');
            stat.append(dot, document.createTextNode(`${count} ${key}`));
            stats.append(stat);
          }
          el.append(stats);
        };

        const offline = (el: Element) => {
          el.textContent = 'offline';
          el.setAttribute('data-saltast-state', 'offline');
        };

        // Stale-while-revalidate: paint the cached tally instantly on repeat views
        // (no waiting on the network), then refresh in the background. Briefly
        // stale is fine — saltast.com is the real dashboard one click away.
        const cached = readCache();
        if (cached) for (const el of elements) render(el, cached);

        (async () => {
          let fresh = null;
          try {
            const response = await fetch(SALTAST_SUMMARY_URL, {
              headers: { accept: 'application/json' },
            });
            if (response.ok) fresh = parseSummary(await response.json());
          } catch {
            // offline / CORS-blocked — keep any cached render.
          }
          if (fresh) {
            try {
              sessionStorage.setItem(CACHE_KEY, JSON.stringify(fresh));
            } catch {
              /* storage unavailable — non-fatal */
            }
            for (const el of elements) render(el, fresh);
          } else if (!cached) {
            for (const el of elements) offline(el);
          }
        })();
      }
    </script>
  </body>
</html>

<style is:global>
  /* Colours are defined in src/lib/palette.ts and mirrored here. This block is
     the ONLY place the sheet may name a colour; src/lib/palette.test.ts asserts
     both halves of that — that :root matches PALETTE exactly, and that nothing
     below writes a hex, an rgb() or a light-dark() of its own. Change a colour
     in the data; the failing test names the line to follow up. */
  :root {
    color-scheme: light dark;

    --font-prose: system-ui, -apple-system, 'Segoe UI', sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

    /* Rhythm. Defined once here so the measure, the type size and the leading
       cannot drift apart — they are one decision about how dense the page is. */
    --measure: 43rem;
    --step-0: 1.0625rem;
    --leading: 1.74;
    --space-section: 4.5rem; /* air above a section break */
    --space-figure: 3rem; /* air around any piece of media */

    /* How far a divider's rule reaches from its label toward the margin.
       THIS IS THE KNOB: 0 removes the rules entirely and leaves the label;
       100% brings full-width rules back. Nothing else needs to change. */
    --divider-reach: 4.5rem;
    --divider-gap: 1.25rem;

    --bg: light-dark(#fafbfa, #111310);
    --ink: light-dark(#1e211d, #e6eae3);
    --muted: light-dark(#5a6158, #a3aa9f);
    --hairline: light-dark(rgb(30 33 29 / 13%), rgb(230 234 227 / 14%));
    --chip: light-dark(rgb(30 33 29 / 5%), rgb(230 234 227 / 7%));
    --accent: light-dark(#0e646c, #6fcdd9);
    --warn: light-dark(#835300, #eebd5c);
    --status-up: light-dark(#136c36, #4ade80);
    --status-down: light-dark(#b01818, #f87171);
    --tint-essay: light-dark(#4338ca, #b4bdfc);
    --tint-til: light-dark(#0c665e, #5eead4);
    --tint-experiment: light-dark(#155e75, #7dd3fc);
    --tint-project: light-dark(#a21caf, #f0abfc);
  }

  /* A reader who has asked their OS for more contrast gets firmer hairlines
     and stronger secondary text — cheap, and it moves the page toward AAA.
     Mirrored from HIGH_CONTRAST in src/lib/palette.ts, which is where the test
     proves these are genuinely stronger rather than merely different.

     No [data-theme] companion is needed, unlike the prefers-color-scheme
     rules: these are light-dark() pairs resolved by color-scheme, which a
     forced theme sets — so the override follows a forced theme for free. */
  @media (prefers-contrast: more) {
    :root {
      --muted: light-dark(#3f453d, #cdd3c8);
      --hairline: light-dark(rgb(30 33 29 / 34%), rgb(230 234 227 / 34%));
    }
  }

  /* Three states, and auto is the ABSENCE of the attribute. Because every token
     is a light-dark() pair, one property flips the whole page. See ADR 0010. */
  :root[data-theme='light'] {
    color-scheme: light;
  }

  :root[data-theme='dark'] {
    color-scheme: dark;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
    max-width: var(--measure);
    font-family: var(--font-prose);
    font-size: var(--step-0);
    line-height: var(--leading);
    color: var(--ink);
    background: var(--bg);
    text-rendering: optimizeLegibility;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* ── Prose ── */

  h1 {
    font-size: 1.625rem;
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.25;
    margin: 0 0 0.5rem;
  }

  h2 {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 2.25em 0 0.5em;
  }

  h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    margin: 1.75em 0 0.5em;
  }

  /* Markdown-native TL;DR: an ordinary heading immediately followed by a list.
     This works unchanged in .md and .mdx and stays deliberately easy to restyle
     during the full design pass in issue #11. */
  article h2#tldr,
  article h2#tldr + ul {
    background: var(--chip);
    border-left: 3px solid var(--accent);
  }

  article h2#tldr {
    margin: 2.25rem 0 0;
    padding: 0.9rem 1.25rem 0.25rem;
    border-radius: 4px 4px 0 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 650;
    letter-spacing: 0;
  }

  article h2#tldr + ul {
    margin: 0 0 2.25rem;
    padding: 0.25rem 1.25rem 1rem 2.75rem;
    border-radius: 0 0 4px 4px;
  }

  article h2#tldr + ul li + li {
    margin-top: 0.35rem;
  }

  p {
    margin: 0 0 1.3em;
  }

  /* Prose list rules are scoped to the article ON PURPOSE.
     A bare `ul { padding-left }` reaches every list on the site — the post
     list, and any nav or footer list added later — and indents rows meant to
     sit flush. Today `.post-list`'s own `padding: 0` happens to survive it (a
     class outranks an element selector whatever the source order), so this is
     defence rather than repair: that reset must not be the only thing standing
     between prose styling and the archive.
     e2e/post-list-alignment.spec.ts asserts the rows line up; the unit test in
     src/lib/prose-scope.test.ts asserts these rules keep their prefix. */
  article ul,
  article ol {
    padding-left: 1.25rem;
  }

  article li + li {
    margin-top: 0.4rem;
  }

  a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--muted);
    text-underline-offset: 0.15em;
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  blockquote {
    margin: 1.5rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 2px solid var(--hairline);
    color: var(--muted);
  }

  hr {
    border: 0;
    border-top: 1px solid var(--hairline);
    margin: 2.5rem 0;
  }

  main img {
    max-width: 100%;
    height: auto;
  }

  /* Excalidraw exports dark strokes on a transparent background — legible on
     a white page, invisible on a dark one. Invert lightness and spin the hue
     back so black-on-transparent reads as light-on-transparent in dark mode,
     without touching the exported SVG file itself.

     THE TRAP: `prefers-color-scheme` asks the OPERATING SYSTEM and cannot see
     a theme the reader forced here. On a light OS with dark forced, the page
     goes dark via color-scheme and this rule never fires — dark strokes on a
     dark ground, invisible. So the query is narrowed to "OS dark AND not
     forced light", and a forced-dark companion sits outside it. Every
     prefers-color-scheme query in this sheet needs both halves;
     src/lib/theme.test.ts asserts that structurally. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) img[src*='excalidraw'] {
      filter: invert(0.92) hue-rotate(180deg);
    }
  }

  :root[data-theme='dark'] img[src*='excalidraw'] {
    filter: invert(0.92) hue-rotate(180deg);
  }

  /* In-article images and diagrams: centered, with room to breathe.
     cursor: zoom-in signals the Lightbox component's click-to-enlarge
     affordance (progressive enhancement — harmless with JS disabled). */
  article > img,
  article p > img {
    display: block;
    margin: var(--space-figure) auto;
    cursor: zoom-in;
  }

  /* Break a figure out wider than the 42rem prose measure, centred on the
     viewport, without restructuring the single-column <body> (which also holds
     the header/footer). The `left: 50%` + `translateX(-50%)` pair re-centres a
     child that's wider than its parent; `min(60rem, 100vw - 2rem)` is the
     gentle first-pass cap — clearly wider than the text on desktop, full-width
     (minus a small gutter) on mobile, and never wide enough to push the page
     into horizontal scroll. A deliberate full-bleed language can come later in
     the #11 design pass by raising this one number. See ADR 0006. */
  .breakout {
    width: min(60rem, 100vw - 2rem);
    position: relative;
    left: 50%;
    transform: translateX(-50%);
  }

  /* ── Header / footer ── */

  /* Off-canvas rather than hidden: a `display: none` element cannot take
     focus, so the link would never appear for the reader it exists for. */
  .skip-link {
    position: absolute;
    top: -4rem;
    left: 0.75rem;
    z-index: 10;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--hairline);
    border-radius: 6px;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-decoration: none;
  }

  .skip-link:focus {
    top: 0.75rem;
  }

  /* A centred stack over a hairline: name, then navigation. The theme control
     is deliberately NOT in this stack — see below.

     `padding-inline` RESERVES the control's column on both sides. It is what
     makes the centred name structurally unable to reach the control, at any
     font size — an absolutely positioned box is offset from the padding box,
     so `right: 0` keeps the control at the far edge while the flow content is
     inset. Symmetric, so the name stays optically centred on the page.

     This replaces two failed attempts at a pixel breakpoint. Both looked right
     on macOS and collided on CI's Linux `system-ui`, which sets the same name
     wider: the first at 430px, the second at 390–400px. A width chosen by hand
     is a guess about a font you do not control. */
  .site-header {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: var(--space-section);
    padding-inline: 6rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--hairline);
    text-align: center;
  }

  .site-name {
    font-size: 1.0625rem;
    font-weight: 620;
    letter-spacing: 0.01em;
    color: var(--ink);
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    /* WCAG 2.2 target size: the label alone is ~16px tall. */
    min-height: 24px;
    color: var(--muted);
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--accent);
  }

  /* The current page is state, so it takes the accent (ADR 0009) — plus an
     underline, because colour alone is not an indicator. */
  .site-nav a[aria-current='page'] {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  /* The theme control is a reader's preference, not a destination — so it sits
     in the far corner rather than in the navigation stack, where it read as a
     third row of nav. Findable if looked for, ignorable otherwise.

     Absolutely positioned so it never shifts the optical centre of the name and
     nav. Each button clears the WCAG 2.2 24px target minimum on its own, before
     any spacing exception is invoked. */
  .theme {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    gap: 0.1rem;
  }

  /* Icons at every width, and no surrounding box. Three words in a bordered
     pill read as a component competing with the masthead; three bare glyphs
     read as a setting. It also makes the control ~86px instead of ~180px, which
     is what stops it colliding with the centred name on a phone — the fix for
     "too obvious on desktop" and "pushes the title down on mobile" is the
     same fix.

     24px targets are kept. Icon-only does NOT cost anything under WCAG here:
     the label stays in the DOM as the accessible name, and 3 × 24px is already
     small enough to be quiet. */
  .theme button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 24px;
    min-width: 28px;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: none;
    color: var(--muted);
    cursor: pointer;
    opacity: 0.65;
  }

  .theme button:hover {
    color: var(--accent);
    opacity: 1;
  }

  .theme button[aria-pressed='true'] {
    color: var(--ink);
    opacity: 1;
  }

  .theme button:focus-visible {
    opacity: 1;
  }

  .theme-icon {
    line-height: 0;
  }

  /* Visually hidden, NOT display:none — the label is the button's accessible
     name, and an icon marked aria-hidden leaves nothing behind it. */
  .theme-label {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Reserving a column on BOTH sides costs 12rem, which a phone does not have
     to spare — so below 34rem the centring is what gives way, not the layout.
     Name and nav go left; only the right column stays reserved, and the
     control stays in the right corner where it is at every other width. A
