---
// Client-side, lazy, theme-aware Mermaid rendering (issue #6). Sätteri
// (Astro 7's native markdown processor) doesn't run remark/rehype plugins,
// so a mermaid block just passes through as plain text — astro.config.mjs's
// `markdown.syntaxHighlight.excludeLangs: ['mermaid']` stops Shiki from
// mangling it into highlighted spans, leaving a clean
// `pre > code.language-mermaid` for this script to find.
//
// Rejected: `rehype-mermaid` (SSR) would force the whole pipeline back onto
// unified/@astrojs/markdown-remark just for this one diagram type, plus a
// Playwright dependency in the build. Not worth it unless client JS becomes
// a real problem (see issue #6).
//
// The `import('mermaid')` below is a real ES module specifier, so Vite
// bundles it into a local chunk under `/_astro/` at build time — the CSP
// (`script-src 'self'`) is satisfied without a CDN allowance, and pages
// with no mermaid block never fetch that chunk at all (the early return
// below happens before the import is ever reached). #121 must not weaken
// that: every listener it adds is registered only after a block is found.
//
// #120 adds the legibility floor. The DECISION is arithmetic and lives in
// src/lib/legibility.ts, where its boundaries are unit-tested; this file only
// measures the DOM, applies the answer, and re-applies it when the container
// changes width.
//
// #121 makes the diagram part of the page rather than a visitor on it: its
// colours come from the design tokens, and it follows the theme the reader
// CHOSE rather than the one their operating system prefers.
---

<script>
  import { decideRender, LEGIBILITY_FLOOR_PX } from '../lib/legibility';
  import { THEME_ATTRIBUTE } from '../lib/theme';

  /** A rendered diagram, kept so it can be re-drawn when the theme changes. */
  interface Diagram {
    figure: HTMLElement;
    scroll: HTMLElement;
    source: string;
  }

  const diagrams: Diagram[] = [];
  let mermaid: typeof import('mermaid').default | null = null;
  let nextId = 0;

  /**
   * A design token resolved to a real colour.
   *
   * `getPropertyValue('--ink')` returns the token as WRITTEN — `light-dark(…)`,
   * unsubstituted — because custom properties are resolved lazily. Painting it
   * onto a throwaway element and reading the computed colour back is what turns
   * it into the rgb the reader is actually looking at, on whichever ground is
   * currently in force. Same trick the palette e2e uses.
   */
  function resolveToken(probe: HTMLElement, token: string): string {
    probe.style.color = `var(${token})`;
    return getComputedStyle(probe).color;
  }

  /**
   * Mermaid theme variables derived from the design tokens.
   *
   * Neutrals only, deliberately. ADR 0009 reserves the accent for STATE and the
   * Category tints for Category words — a diagram that borrowed either would be
   * saying something it does not mean. What a diagram needs is a surface, ink,
   * and a line, and the palette already has all three.
   */
  function themeVariables(): Record<string, string> {
    const probe = document.createElement('span');
    probe.style.position = 'absolute';
    probe.style.visibility = 'hidden';
    document.body.append(probe);

    const bg = resolveToken(probe, '--bg');
    const ink = resolveToken(probe, '--ink');
    const muted = resolveToken(probe, '--muted');
    const chip = resolveToken(probe, '--chip');
    const hairline = resolveToken(probe, '--hairline');
    probe.remove();

    return {
      background: bg,
      // Node fills sit on --chip, which the contrast model already knows as a
      // ground that carries text (see GROUNDS in src/lib/palette.ts).
      primaryColor: chip,
      secondaryColor: chip,
      tertiaryColor: bg,
      mainBkg: chip,
      clusterBkg: bg,
      clusterBorder: hairline,
      primaryTextColor: ink,
      textColor: ink,
      titleColor: ink,
      primaryBorderColor: muted,
      nodeBorder: muted,
      lineColor: muted,
      edgeLabelBackground: bg,
      fontFamily: getComputedStyle(document.body).fontFamily,
      // Pinned rather than inherited: this is the number the legibility floor
      // is expressed against, so it must not drift with the prose type scale.
      fontSize: '16px',
    };
  }

  /** The label size a diagram is drawn with, in its own units. */
  function baseLabelPx(svg: SVGSVGElement): number {
    // Mermaid renders labels as HTML inside <foreignObject> by default, and
    // falls back to <text> when htmlLabels is off. Either way the computed
    // font-size is in user units — the viewBox scaling happens at paint, so it
    // does not move — which is exactly the number the floor is expressed in.
    const label = svg.querySelector<Element>('.nodeLabel, .edgeLabel, text');
    if (!label) return Number.NaN;
    return Number.parseFloat(getComputedStyle(label).fontSize);
  }

  /** Measure, decide, apply. Safe to call repeatedly. */
  function applyFloor(figure: HTMLElement, scroll: HTMLElement) {
    const svg = scroll.querySelector('svg');
    if (!svg) return;

    const decision = decideRender({
      naturalWidth: svg.viewBox?.baseVal?.width ?? Number.NaN,
      containerWidth: figure.clientWidth,
      baseLabelPx: baseLabelPx(svg),
      floorPx: LEGIBILITY_FLOOR_PX,
    });

    svg.style.width = `${decision.renderWidth}px`;
    // Mermaid's `useMaxWidth` pins a max-width at the natural size, which would
    // veto the floor's answer whenever the floor wants to grow a diagram.
    svg.style.maxWidth = 'none';
    svg.style.height = 'auto';

    const scrolls = decision.mode === 'scroll';
    scroll.classList.toggle('is-scrollable', scrolls);

    // A scroll region is only announced, and only focusable, when it actually
    // scrolls. A tabindex on a container that fits is a tab stop that does
    // nothing, and a role="region" with nothing to reach is noise for a screen
    // reader — so both are attached and removed with the behaviour.
    if (scrolls) {
      scroll.setAttribute('tabindex', '0');
      scroll.setAttribute('role', 'region');
      scroll.setAttribute('aria-label', 'Diagram, scrollable sideways');
    } else {
      scroll.removeAttribute('tabindex');
      scroll.removeAttribute('role');
      scroll.removeAttribute('aria-label');
    }
  }

  /** Draw (or re-draw) one diagram on the current ground. */
  async function draw({ figure, scroll, source }: Diagram) {
    if (!mermaid) return;
    const { svg, bindFunctions } = await mermaid.render(`mermaid-${nextId++}`, source);
    scroll.innerHTML = svg;
    bindFunctions?.(scroll);
    // The floor is measured from the RENDERED diagram, so it has to be applied
    // again after every re-theme: a different theme can change label metrics,
    // and a stale decision would leave the diagram sized for a drawing that no
    // longer exists.
    applyFloor(figure, scroll);
  }

  /** Re-initialise on the current ground and re-draw everything. */
  async function retheme() {
    if (!mermaid || diagrams.length === 0) return;
    mermaid.initialize({
      startOnLoad: false,
      // `base` is the theme intended to be driven by themeVariables; `dark` and
      // `neutral` bring their own palettes and would fight the tokens.
      //
      // There is deliberately no OS-preference read here, and no `darkMode`
      // flag. The old code picked the library's palette from
      // `matchMedia('(prefers-color-scheme: dark)')`, which is why a forced
      // theme was ignored. Rather than feed that switch a better signal, the
      // switch is gone: the tokens below are resolved from the live document,
      // so they already carry whatever ground is in force — chosen or
      // inherited — and there is nothing left to get wrong. `darkMode` was
      // measured to change nothing once themeVariables are supplied, so
      // keeping it would have been a knob that looked load-bearing and was not.
      theme: 'base',
      themeVariables: themeVariables(),
    });
    for (const diagram of diagrams) await draw(diagram);
  }

  async function renderMermaid() {
    const blocks = document.querySelectorAll<HTMLElement>('pre > code.language-mermaid');
    if (blocks.length === 0) return;

    mermaid = (await import('mermaid')).default;

    for (const block of blocks) {
      const pre = block.parentElement;
      if (!pre) continue;

      // `breakout` lets the diagram render wider than the prose column so it
      // stays legible without shrinking to the paragraph measure (see the
      // `.breakout` rule + ADR 0006). The inner element is what scrolls when
      // the floor says it must: the OUTER box keeps its place in the layout, so
      // the page itself never scrolls sideways whatever the diagram is doing.
      const figure = document.createElement('div');
      figure.className = 'mermaid-diagram breakout';
      const scroll = document.createElement('div');
      scroll.className = 'mermaid-diagram__scroll';
      figure.append(scroll);
      pre.replaceWith(figure);

      // The SOURCE is kept, not just the rendered SVG. Re-theming means
      // re-rendering, and the markup it came from is gone from the page by now.
      diagrams.push({ figure, scroll, source: block.textContent ?? '' });

      // A phone that rotates, a window that resizes, or a font that loads late
      // all change the floor's answer. Without this the decision is made once
      // against a width that may no longer exist.
      if (typeof ResizeObserver !== 'undefined') {
        new ResizeObserver(() => applyFloor(figure, scroll)).observe(figure);
      }
    }

    await retheme();

    // Both signals, because either can change the ground:
    //   - the reader uses the theme control  -> data-theme is set or removed
    //   - the reader is on `system` and the OS flips -> the media query changes
    // Registered here, after a block was found, so a page without a diagram
    // still adds nothing and still never reaches the import above.
    new MutationObserver(retheme).observe(document.documentElement, {
      attributes: true,
      attributeFilter: [THEME_ATTRIBUTE],
    });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', retheme);
  }

  renderMermaid();
</script>

<style is:global>
  .mermaid-diagram {
    margin: 2rem 0;
    /* Signals the click-to-enlarge affordance the Lightbox wires up (matches
       `article img`); harmless with JS disabled. */
    cursor: zoom-in;
  }

  /* The scroll lives HERE, one level in, so a diagram that has to be wider than
     the viewport pushes nothing else sideways. WCAG 1.4.10 exempts content
     requiring two-dimensional layout, which a diagram is — but the exemption
     covers the diagram, not the page around it. */
  .mermaid-diagram__scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  /* Only a container that actually scrolls gets a focus ring worth showing —
     it is only focusable in that state (see applyFloor). */
  .mermaid-diagram__scroll.is-scrollable:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .mermaid-diagram svg {
    display: block;
    margin: 0 auto;
  }
</style>
