---
import { Image } from 'astro:assets';
import { figureClass, type MediaKind } from '../lib/figure';

/**
 * The first component to emit the figure contract (#117) — the tracer bullet.
 *
 * The shape every framed medium will take:
 *
 *   <figure class="media …" data-media="<kind>">
 *     <div class="media__body"> … </div>
 *     <figcaption class="media__caption"> … </figcaption>   (optional)
 *   </figure>
 *
 * `kind` is REQUIRED and has no default. A default would be a decision nobody
 * made: the kind says what the thing IS, and only the author knows. The
 * framing for each kind lives in src/styles/media.css, one selector apiece.
 *
 * `breakout` opts into the EXISTING layout primitive (ADR 0006, 60rem). The
 * design's proposed wide-media class is deliberately not introduced — the
 * primitive already does that job and is tested.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  /** What this is. See MEDIA_KINDS in src/lib/figure.ts. */
  kind: MediaKind;
  /** Optional caption. Stays at the reading measure however wide the figure runs. */
  caption?: string;
  /** Break out past the reading measure, using the existing primitive. */
  breakout?: boolean;
}

const { src, alt, kind, caption, breakout = false } = Astro.props;

// A broken-out figure is asking to be seen at size, so it takes the wider
// candidate set and the wider `sizes`. The constrained case keeps exactly the
// candidates and `sizes` it had before this ticket — its readers must see no
// change.
const widths = breakout ? [560, 960, 1440] : [320, 560, 720];
const sizes = breakout ? 'min(60rem, calc(100vw - 2rem))' : 'min(34rem, calc(100vw - 2.5rem))';
---

<figure class={figureClass('article-image', { breakout })} data-media={kind}>
  <div class="media__body">
    <Image src={src} alt={alt} widths={widths} sizes={sizes} />
  </div>
  {caption && <figcaption class="media__caption">{caption}</figcaption>}
</figure>

<style>
  /* Sizing and vertical rhythm stay with the component; the SHAPE and the
     per-kind framing are the contract's (src/styles/media.css). #118 is where
     the migrated components agree on one answer for spacing — until then,
     changing it here would move a published Post for no reason. */
  .article-image {
    margin: 2rem auto;
  }

  .article-image .media__body {
    max-width: min(34rem, 100%);
    margin-inline: auto;
  }

  .article-image .media__body :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* A tall image is cropped to a tidy height rather than dominating the column
     — EXCEPT a screenshot, which loses the thing being shown.
     
     Two decisions live here on purpose, and they belong to different axes. How
     tall a figure may be in THIS component's layout is the component's; "never
     crop a screenshot" is the kind's. The component defers to the kind rather
     than the contract trying to out-specify it: an Astro scope attribute
     outranks a global rule, so a `[data-media]` selector in media.css could
     never have overridden this from outside.
     
     Briefly tried the other way round in #124, and the aside's tall research
     card started being cropped — because "photo" is a kind shared by several
     components, and only ONE of them wanted a height cap. */
  .article-image:not([data-media='screenshot']) .media__body :global(img) {
    max-height: min(32rem, 72vh);
    object-fit: cover;
  }

  /* Broken out, the constraints that make a small figure tidy become wrong:
     a 34rem cap would defeat the breakout, and cropping to 32rem tall is a
     thumbnail gesture applied to something asking to be looked at. */
  .article-image.breakout .media__body {
    max-width: none;
  }

  .article-image.breakout .media__body :global(img) {
    max-height: none;
    object-fit: contain;
  }
</style>
